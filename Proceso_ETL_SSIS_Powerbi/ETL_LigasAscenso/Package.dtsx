    <DTS:Executable DTS:refId="Package\Configurar sesión DW" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{40C12BF9-EEFE-479A-A535-A45E60F1ACDB}" DTS:ObjectName="Configurar sesión DW" DTS:DelayValidation="True" DTS:LocaleID="-1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{A9894B2F-66FE-4BB2-8D12-38C29CE8F6AF}" SQLTask:BypassPrepare="True" SQLTask:SqlStatementSource="DECLARE @Catalogo nvarchar(128);&#10;SET @Catalogo = ?;&#10;EXEC sys.sp_set_session_context @key = N'ETL.BaseStaging', @value = @Catalogo;">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Project::BaseStaging" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="128" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Cargar DimTiempo" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{07D1FDB8-7848-483D-BBC4-286DC48196F7}" DTS:ObjectName="Cargar DimTiempo" DTS:DelayValidation="True" DTS:LocaleID="-1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{A9894B2F-66FE-4BB2-8D12-38C29CE8F6AF}" SQLTask:BypassPrepare="True" SQLTask:SqlStatementSource="DECLARE @Catalogo nvarchar(4000);&#10;SET @Catalogo = CONVERT(nvarchar(4000), SESSION_CONTEXT(N'ETL.BaseStaging'));&#10;SET NOCOUNT ON;&#10;SET XACT_ABORT ON;&#10;BEGIN TRY&#10;    IF @Catalogo IS NULL OR LEN(@Catalogo) = 0 OR LEN(@Catalogo) &gt; 128&#10;        THROW 51004, 'Configure BaseStaging con un nombre de base válido.', 1;&#10;    IF DB_ID(@Catalogo) IS NULL OR DB_ID(@Catalogo) = DB_ID()&#10;        THROW 51005, 'BaseStaging debe identificar otra base accesible en la instancia del DW.', 1;&#10;    IF OBJECT_ID(N'dbo.FactVentas', N'U') IS NULL&#10;        OR OBJECT_ID(N'dbo.FactAsistencia', N'U') IS NULL&#10;        THROW 51008, 'El DW debe tener dbo.FactVentas y dbo.FactAsistencia. Revise BaseDW y el script DW_ligasdeAscenso_new.sql.', 1;&#10;    IF @@TRANCOUNT &lt;&gt; 0&#10;        THROW 51007, 'CM_DWNEW ya tiene una transacción activa.', 1;&#10;    BEGIN TRANSACTION;&#10;    DECLARE @Sql nvarchar(max) = CONVERT(nvarchar(max), N'')&#10;        + N'SET LANGUAGE Spanish;&#10;SET DATEFIRST 1;&#10;DECLARE @LockResult int;&#10;    EXEC @LockResult = sys.sp_getapplock&#10;        @Resource = N''ETL_LigasAscenso.DW'', @LockMode = ''Exclusive'',&#10;        @LockOwner = ''Transaction'', @LockTimeout = 60000;&#10;    IF @LockResult &lt; 0 THROW 51001, ''No se consiguió el bloqueo del DW.'', 1;&#10;&#10;    IF EXISTS (SELECT 1 FROM @CATALOGO@.dbo.stg_Boletos AS b&#10;               WHERE NOT EXISTS (SELECT 1 FROM @CATALOGO@.dbo.stg_Partidos AS p WHERE p.IDPartidoOrigen = b.IDPartidoOrigen))&#10;       OR EXISTS (SELECT 1 FROM @CATALOGO@.dbo.stg_Asistencia AS a&#10;                  WHERE NOT EXISTS (SELECT 1 FROM @CATALOGO@.dbo.stg_Partidos AS p WHERE p.IDPartidoOrigen = a.IDPartidoOrigen))&#10;        THROW 51002, ''Staging contiene boletos o asistencia sin partido. Reintente con el origen estable.'', 1;&#10;&#10;SELECT DISTINCT IDTiempo, Fecha, Anio, Mes, NombreMes, Dia, DiaSemana, NombreDiaSemana, EsFinDeSemana&#10;INTO #DimTiempo&#10;FROM (&#10;    SELECT CONVERT(int, CONVERT(char(8), f.Fecha, 112)), f.Fecha,&#10;           YEAR(f.Fecha), MONTH(f.Fecha), DATENAME(month, f.Fecha),&#10;           DAY(f.Fecha), DATEPART(weekday, f.Fecha), DATENAME(weekday, f.Fecha),&#10;           CONVERT(bit, CASE WHEN DATEPART(weekday, f.Fecha) IN (6, 7) THEN 1 ELSE 0 END)&#10;    FROM @CATALOGO@.dbo.stg_Partidos AS p&#10;    CROSS APPLY (VALUES (CONVERT(date, p.FechaHoraPartido))) AS f (Fecha)&#10;) AS d (IDTiempo, Fecha, Anio, Mes, NombreMes, Dia, DiaSemana, NombreDiaSemana, EsFinDeSemana);&#10;CREATE UNIQUE CLUSTERED INDEX IX_DimTiempo ON #DimTiempo (IDTiempo);&#10;&#10;UPDATE dst SET&#10;    Fecha = src.Fecha,&#10;    Anio = src.Anio,&#10;    Mes = src.Mes,&#10;    N'&#10;        + N'ombreMes = src.NombreMes,&#10;    Dia = src.Dia,&#10;    DiaSemana = src.DiaSemana,&#10;    NombreDiaSemana = src.NombreDiaSemana,&#10;    EsFinDeSemana = src.EsFinDeSemana&#10;FROM dbo.DimTiempo AS dst&#10;JOIN #DimTiempo AS src ON src.IDTiempo = dst.IDTiempo&#10;WHERE EXISTS (&#10;    SELECT src.Fecha, src.Anio, src.Mes, src.NombreMes, src.Dia, src.DiaSemana, src.NombreDiaSemana, src.EsFinDeSemana&#10;    EXCEPT&#10;    SELECT dst.Fecha, dst.Anio, dst.Mes, dst.NombreMes, dst.Dia, dst.DiaSemana, dst.NombreDiaSemana, dst.EsFinDeSemana&#10;);&#10;&#10;INSERT INTO dbo.DimTiempo (IDTiempo, Fecha, Anio, Mes, NombreMes, Dia, DiaSemana, NombreDiaSemana, EsFinDeSemana)&#10;SELECT IDTiempo, Fecha, Anio, Mes, NombreMes, Dia, DiaSemana, NombreDiaSemana, EsFinDeSemana FROM #DimTiempo AS src&#10;WHERE NOT EXISTS (SELECT 1 FROM dbo.DimTiempo AS dst WHERE dst.IDTiempo = src.IDTiempo);&#10;';&#10;    SET @Sql = REPLACE(@Sql, N'@CATALOGO@', QUOTENAME(@Catalogo));&#10;    EXEC sys.sp_executesql @Sql;&#10;END TRY&#10;BEGIN CATCH&#10;    IF XACT_STATE() &lt;&gt; 0 ROLLBACK TRANSACTION;&#10;    THROW;&#10;END CATCH;&#10;">
          </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Cargar DimTemporada" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{4AD1A131-B632-447D-93A7-3AAE6096EA35}" DTS:ObjectName="Cargar DimTemporada" DTS:DelayValidation="True" DTS:LocaleID="-1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{A9894B2F-66FE-4BB2-8D12-38C29CE8F6AF}" SQLTask:BypassPrepare="True" SQLTask:SqlStatementSource="DECLARE @Catalogo nvarchar(4000);&#10;SET @Catalogo = CONVERT(nvarchar(4000), SESSION_CONTEXT(N'ETL.BaseStaging'));&#10;SET NOCOUNT ON;&#10;SET XACT_ABORT ON;&#10;BEGIN TRY&#10;    IF @Catalogo IS NULL OR LEN(@Catalogo) = 0 OR LEN(@Catalogo) &gt; 128&#10;        THROW 51004, 'Configure BaseStaging con un nombre de base válido.', 1;&#10;    IF DB_ID(@Catalogo) IS NULL OR DB_ID(@Catalogo) = DB_ID()&#10;        THROW 51005, 'BaseStaging debe identificar otra base accesible en la instancia del DW.', 1;&#10;    IF XACT_STATE() &lt;&gt; 1 OR @@TRANCOUNT &lt;&gt; 1&#10;        THROW 51006, 'No hay una transacción activa del ETL en CM_DWNEW.', 1;&#10;    DECLARE @Sql nvarchar(max) = CONVERT(nvarchar(max), N'')&#10;        + N'SELECT DISTINCT IDTemporada, Anio, FechaInicio, FechaFinal&#10;INTO #DimTemporada&#10;FROM (&#10;    SELECT IDTemporadaOrigen, AnioTemporada, FechaInicioTemporada, FechaFinTemporada&#10;    FROM @CATALOGO@.dbo.stg_Partidos&#10;) AS d (IDTemporada, Anio, FechaInicio, FechaFinal);&#10;CREATE UNIQUE CLUSTERED INDEX IX_DimTemporada ON #DimTemporada (IDTemporada);&#10;&#10;UPDATE dst SET&#10;    Anio = src.Anio,&#10;    FechaInicio = src.FechaInicio,&#10;    FechaFinal = src.FechaFinal&#10;FROM dbo.DimTemporada AS dst&#10;JOIN #DimTemporada AS src ON src.IDTemporada = dst.IDTemporada&#10;WHERE EXISTS (&#10;    SELECT src.Anio, src.FechaInicio, src.FechaFinal&#10;    EXCEPT&#10;    SELECT dst.Anio, dst.FechaInicio, dst.FechaFinal&#10;);&#10;&#10;INSERT INTO dbo.DimTemporada (IDTemporada, Anio, FechaInicio, FechaFinal)&#10;SELECT IDTemporada, Anio, FechaInicio, FechaFinal FROM #DimTemporada AS src&#10;WHERE NOT EXISTS (SELECT 1 FROM dbo.DimTemporada AS dst WHERE dst.IDTemporada = src.IDTemporada);&#10;';&#10;    SET @Sql = REPLACE(@Sql, N'@CATALOGO@', QUOTENAME(@Catalogo));&#10;    EXEC sys.sp_executesql @Sql;&#10;END TRY&#10;BEGIN CATCH&#10;    IF XACT_STATE() &lt;&gt; 0 ROLLBACK TRANSACTION;&#10;    THROW;&#10;END CATCH;&#10;">
          </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Cargar DimEstadio" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{A6EA9002-DDE2-4839-A19D-E91E24151BD4}" DTS:ObjectName="Cargar DimEstadio" DTS:DelayValidation="True" DTS:LocaleID="-1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{A9894B2F-66FE-4BB2-8D12-38C29CE8F6AF}" SQLTask:BypassPrepare="True" SQLTask:SqlStatementSource="DECLARE @Catalogo nvarchar(4000);&#10;SET @Catalogo = CONVERT(nvarchar(4000), SESSION_CONTEXT(N'ETL.BaseStaging'));&#10;SET NOCOUNT ON;&#10;SET XACT_ABORT ON;&#10;BEGIN TRY&#10;    IF @Catalogo IS NULL OR LEN(@Catalogo) = 0 OR LEN(@Catalogo) &gt; 128&#10;        THROW 51004, 'Configure BaseStaging con un nombre de base válido.', 1;&#10;    IF DB_ID(@Catalogo) IS NULL OR DB_ID(@Catalogo) = DB_ID()&#10;        THROW 51005, 'BaseStaging debe identificar otra base accesible en la instancia del DW.', 1;&#10;    IF XACT_STATE() &lt;&gt; 1 OR @@TRANCOUNT &lt;&gt; 1&#10;        THROW 51006, 'No hay una transacción activa del ETL en CM_DWNEW.', 1;&#10;    DECLARE @Sql nvarchar(max) = CONVERT(nvarchar(max), N'')&#10;        + N'SELECT DISTINCT IDEstadio, NombreEstadio, Departamento, Provincia, Distrito, Region, Categoria, MaxAforo&#10;INTO #DimEstadio&#10;FROM (&#10;    SELECT IDEstadioOrigen, NombreEstadio, DepartamentoEstadio, ProvinciaEstadio,&#10;           DistritoEstadio, RegionEstadio, CategoriaEstadio, MaxAforo&#10;    FROM @CATALOGO@.dbo.stg_Partidos&#10;) AS d (IDEstadio, NombreEstadio, Departamento, Provincia, Distrito, Region, Categoria, MaxAforo);&#10;CREATE UNIQUE CLUSTERED INDEX IX_DimEstadio ON #DimEstadio (IDEstadio);&#10;&#10;UPDATE dst SET&#10;    NombreEstadio = src.NombreEstadio,&#10;    Departamento = src.Departamento,&#10;    Provincia = src.Provincia,&#10;    Distrito = src.Distrito,&#10;    Region = src.Region,&#10;    Categoria = src.Categoria,&#10;    MaxAforo = src.MaxAforo&#10;FROM dbo.DimEstadio AS dst&#10;JOIN #DimEstadio AS src ON src.IDEstadio = dst.IDEstadio&#10;WHERE EXISTS (&#10;    SELECT src.NombreEstadio, src.Departamento, src.Provincia, src.Distrito, src.Region, src.Categoria, src.MaxAforo&#10;    EXCEPT&#10;    SELECT dst.NombreEstadio, dst.Departamento, dst.Provincia, dst.Distrito, dst.Region, dst.Categoria, dst.MaxAforo&#10;);&#10;&#10;INSERT INTO dbo.DimEstadio (IDEstadio, NombreEstadio, Departamento, Provincia, Distrito, Region, Categoria, MaxAforo)&#10;SELECT IDEstadio, NombreEstadio, Departamento, Provincia, Distrito, Region, Categoria, MaxAforo FROM #DimEstadio AS src&#10;WHERE NOT EXISTS (SELECT 1 FROM dbo.DimEstadio AS dst WHERE dst.IDEstadio = src.IDEstadio);&#10;';&#10;    SET @Sql = REPLACE(@Sql, N'@CATALOGO@', QUOTENAME(@Catalogo));&#10;    EXEC sys.sp_executesql @Sql;&#10;END TRY&#10;BEGIN CATCH&#10;    IF XACT_STATE() &lt;&gt; 0 ROLLBACK TRANSACTION;&#10;    THROW;&#10;END CATCH;&#10;">
          </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Cargar DimCompeticion" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{EF96B116-84EB-454C-8FD0-4E817E495D79}" DTS:ObjectName="Cargar DimCompeticion" DTS:DelayValidation="True" DTS:LocaleID="-1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{A9894B2F-66FE-4BB2-8D12-38C29CE8F6AF}" SQLTask:BypassPrepare="True" SQLTask:SqlStatementSource="DECLARE @Catalogo nvarchar(4000);&#10;SET @Catalogo = CONVERT(nvarchar(4000), SESSION_CONTEXT(N'ETL.BaseStaging'));&#10;SET NOCOUNT ON;&#10;SET XACT_ABORT ON;&#10;BEGIN TRY&#10;    IF @Catalogo IS NULL OR LEN(@Catalogo) = 0 OR LEN(@Catalogo) &gt; 128&#10;        THROW 51004, 'Configure BaseStaging con un nombre de base válido.', 1;&#10;    IF DB_ID(@Catalogo) IS NULL OR DB_ID(@Catalogo) = DB_ID()&#10;        THROW 51005, 'BaseStaging debe identificar otra base accesible en la instancia del DW.', 1;&#10;    IF XACT_STATE() &lt;&gt; 1 OR @@TRANCOUNT &lt;&gt; 1&#10;        THROW 51006, 'No hay una transacción activa del ETL en CM_DWNEW.', 1;&#10;    DECLARE @Sql nvarchar(max) = CONVERT(nvarchar(max), N'')&#10;        + N'SELECT DISTINCT IDEtapa, IDCompeticionOrigen, NombreCompeticion, Organizador, NivelCompeticion, NombreEtapa, NivelEtapa, FactorPrecio&#10;INTO #DimCompeticion&#10;FROM (&#10;    SELECT IDEtapaOrigen, IDCompeticionOrigen, NombreCompeticion, Organizador,&#10;           NivelCompeticion, NombreEtapa, NivelEtapa, FactorPrecio&#10;    FROM @CATALOGO@.dbo.stg_Partidos&#10;) AS d (IDEtapa, IDCompeticionOrigen, NombreCompeticion, Organizador, NivelCompeticion, NombreEtapa, NivelEtapa, FactorPrecio);&#10;CREATE UNIQUE CLUSTERED INDEX IX_DimCompeticion ON #DimCompeticion (IDEtapa);&#10;&#10;UPDATE dst SET&#10;    IDCompeticionOrigen = src.IDCompeticionOrigen,&#10;    NombreCompeticion = src.NombreCompeticion,&#10;    Organizador = src.Organizador,&#10;    NivelCompeticion = src.NivelCompeticion,&#10;    NombreEtapa = src.NombreEtapa,&#10;    NivelEtapa = src.NivelEtapa,&#10;    FactorPrecio = src.FactorPrecio&#10;FROM dbo.DimCompeticion AS dst&#10;JOIN #DimCompeticion AS src ON src.IDEtapa = dst.IDEtapa&#10;WHERE EXISTS (&#10;    SELECT src.IDCompeticionOrigen, src.NombreCompeticion, src.Organizador, src.NivelCompeticion, src.NombreEtapa, src.NivelEtapa, src.FactorPrecio&#10;    EXCEPT&#10;    SELECT dst.IDCompeticionOrigen, dst.NombreCompeticion, dst.Organizador, dst.NivelCompeticion, dst.NombreEtapa, dst.NivelEtapa, dst.FactorPrecio&#10;);&#10;&#10;INSERT INTO dbo.DimCompeticion (IDEtapa, IDCompeticionOrigen, NombreCompeticion, Organizador, NivelCompeticion, NombreEtapa, NivelEtapa, FactorPrecio)&#10;SELECT IDEtapa, IDCompeticionOrigen, NombreCompeticion, Organizador, NivelCompeticion, NombreEtapa, NivelEtapa, FactorPrecio FROM #DimCompeticion AS src&#10;WHERE NOT EXISTS (SELECT 1 FROM d'&#10;        + N'bo.DimCompeticion AS dst WHERE dst.IDEtapa = src.IDEtapa);&#10;';&#10;    SET @Sql = REPLACE(@Sql, N'@CATALOGO@', QUOTENAME(@Catalogo));&#10;    EXEC sys.sp_executesql @Sql;&#10;END TRY&#10;BEGIN CATCH&#10;    IF XACT_STATE() &lt;&gt; 0 ROLLBACK TRANSACTION;&#10;    THROW;&#10;END CATCH;&#10;">
          </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Cargar DimTipoEntrada" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{128B0F98-6B9B-4476-BD4D-570CD4106F69}" DTS:ObjectName="Cargar DimTipoEntrada" DTS:DelayValidation="True" DTS:LocaleID="-1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{A9894B2F-66FE-4BB2-8D12-38C29CE8F6AF}" SQLTask:BypassPrepare="True" SQLTask:SqlStatementSource="DECLARE @Catalogo nvarchar(4000);&#10;SET @Catalogo = CONVERT(nvarchar(4000), SESSION_CONTEXT(N'ETL.BaseStaging'));&#10;SET NOCOUNT ON;&#10;SET XACT_ABORT ON;&#10;BEGIN TRY&#10;    IF @Catalogo IS NULL OR LEN(@Catalogo) = 0 OR LEN(@Catalogo) &gt; 128&#10;        THROW 51004, 'Configure BaseStaging con un nombre de base válido.', 1;&#10;    IF DB_ID(@Catalogo) IS NULL OR DB_ID(@Catalogo) = DB_ID()&#10;        THROW 51005, 'BaseStaging debe identificar otra base accesible en la instancia del DW.', 1;&#10;    IF XACT_STATE() &lt;&gt; 1 OR @@TRANCOUNT &lt;&gt; 1&#10;        THROW 51006, 'No hay una transacción activa del ETL en CM_DWNEW.', 1;&#10;    DECLARE @Sql nvarchar(max) = CONVERT(nvarchar(max), N'')&#10;        + N'SELECT DISTINCT IDTipoEntrada, NombreTE, PrecioBase&#10;INTO #DimTipoEntrada&#10;FROM (&#10;    SELECT IDTipoEntradaOrigen, NombreTipoEntrada, PrecioBase FROM @CATALOGO@.dbo.stg_Boletos&#10;) AS d (IDTipoEntrada, NombreTE, PrecioBase);&#10;CREATE UNIQUE CLUSTERED INDEX IX_DimTipoEntrada ON #DimTipoEntrada (IDTipoEntrada);&#10;&#10;UPDATE dst SET&#10;    NombreTE = src.NombreTE,&#10;    PrecioBase = src.PrecioBase&#10;FROM dbo.DimTipoEntrada AS dst&#10;JOIN #DimTipoEntrada AS src ON src.IDTipoEntrada = dst.IDTipoEntrada&#10;WHERE EXISTS (&#10;    SELECT src.NombreTE, src.PrecioBase&#10;    EXCEPT&#10;    SELECT dst.NombreTE, dst.PrecioBase&#10;);&#10;&#10;INSERT INTO dbo.DimTipoEntrada (IDTipoEntrada, NombreTE, PrecioBase)&#10;SELECT IDTipoEntrada, NombreTE, PrecioBase FROM #DimTipoEntrada AS src&#10;WHERE NOT EXISTS (SELECT 1 FROM dbo.DimTipoEntrada AS dst WHERE dst.IDTipoEntrada = src.IDTipoEntrada);&#10;';&#10;    SET @Sql = REPLACE(@Sql, N'@CATALOGO@', QUOTENAME(@Catalogo));&#10;    EXEC sys.sp_executesql @Sql;&#10;END TRY&#10;BEGIN CATCH&#10;    IF XACT_STATE() &lt;&gt; 0 ROLLBACK TRANSACTION;&#10;    THROW;&#10;END CATCH;&#10;">
          </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Cargar DimClub" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{574AB000-63EE-494A-9A9F-E17693061B19}" DTS:ObjectName="Cargar DimClub" DTS:DelayValidation="True" DTS:LocaleID="-1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{A9894B2F-66FE-4BB2-8D12-38C29CE8F6AF}" SQLTask:BypassPrepare="True" SQLTask:SqlStatementSource="DECLARE @Catalogo nvarchar(4000);&#10;SET @Catalogo = CONVERT(nvarchar(4000), SESSION_CONTEXT(N'ETL.BaseStaging'));&#10;SET NOCOUNT ON;&#10;SET XACT_ABORT ON;&#10;BEGIN TRY&#10;    IF @Catalogo IS NULL OR LEN(@Catalogo) = 0 OR LEN(@Catalogo) &gt; 128&#10;        THROW 51004, 'Configure BaseStaging con un nombre de base válido.', 1;&#10;    IF DB_ID(@Catalogo) IS NULL OR DB_ID(@Catalogo) = DB_ID()&#10;        THROW 51005, 'BaseStaging debe identificar otra base accesible en la instancia del DW.', 1;&#10;    IF XACT_STATE() &lt;&gt; 1 OR @@TRANCOUNT &lt;&gt; 1&#10;        THROW 51006, 'No hay una transacción activa del ETL en CM_DWNEW.', 1;&#10;    DECLARE @Sql nvarchar(max) = CONVERT(nvarchar(max), N'')&#10;        + N'SELECT DISTINCT IDClub, NombreClub, Departamento, Provincia, AnioFundacion&#10;INTO #DimClub&#10;FROM (&#10;    SELECT IDClubLocalOrigen, NombreClubLocal, DepartamentoClubLocal, ProvinciaClubLocal, AnioFundacionLocal FROM @CATALOGO@.dbo.stg_Partidos&#10;    UNION ALL&#10;    SELECT IDClubVisitaOrigen, NombreClubVisita, DepartamentoClubVisita, ProvinciaClubVisita, AnioFundacionVisita FROM @CATALOGO@.dbo.stg_Partidos&#10;) AS d (IDClub, NombreClub, Departamento, Provincia, AnioFundacion);&#10;CREATE UNIQUE CLUSTERED INDEX IX_DimClub ON #DimClub (IDClub);&#10;&#10;UPDATE dst SET&#10;    NombreClub = src.NombreClub,&#10;    Departamento = src.Departamento,&#10;    Provincia = src.Provincia,&#10;    AnioFundacion = src.AnioFundacion&#10;FROM dbo.DimClub AS dst&#10;JOIN #DimClub AS src ON src.IDClub = dst.IDClub&#10;WHERE EXISTS (&#10;    SELECT src.NombreClub, src.Departamento, src.Provincia, src.AnioFundacion&#10;    EXCEPT&#10;    SELECT dst.NombreClub, dst.Departamento, dst.Provincia, dst.AnioFundacion&#10;);&#10;&#10;INSERT INTO dbo.DimClub (IDClub, NombreClub, Departamento, Provincia, AnioFundacion)&#10;SELECT IDClub, NombreClub, Departamento, Provincia, AnioFundacion FROM #DimClub AS src&#10;WHERE NOT EXISTS (SELECT 1 FROM dbo.DimClub AS dst WHERE dst.IDClub = src.IDClub);&#10;';&#10;    SET @Sql = REPLACE(@Sql, N'@CATALOGO@', QUOTENAME(@Catalogo));&#10;    EXEC sys.sp_executesql @Sql;&#10;END TRY&#10;BEGIN CATCH&#10;    IF XACT_STATE() &lt;&gt; 0 ROLLBACK TRANSACTION;&#10;    THROW;&#10;END CATCH;&#10;">
          </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Cargar FactVentas" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{649EBDFF-D7E2-477A-9E85-0A375452DE66}" DTS:ObjectName="Cargar FactVentas" DTS:DelayValidation="True" DTS:LocaleID="-1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{A9894B2F-66FE-4BB2-8D12-38C29CE8F6AF}" SQLTask:BypassPrepare="True" SQLTask:SqlStatementSource="DECLARE @Catalogo nvarchar(4000);&#10;SET @Catalogo = CONVERT(nvarchar(4000), SESSION_CONTEXT(N'ETL.BaseStaging'));&#10;SET NOCOUNT ON;&#10;SET XACT_ABORT ON;&#10;BEGIN TRY&#10;    IF @Catalogo IS NULL OR LEN(@Catalogo) = 0 OR LEN(@Catalogo) &gt; 128&#10;        THROW 51004, 'Configure BaseStaging con un nombre de base válido.', 1;&#10;    IF DB_ID(@Catalogo) IS NULL OR DB_ID(@Catalogo) = DB_ID()&#10;        THROW 51005, 'BaseStaging debe identificar otra base accesible en la instancia del DW.', 1;&#10;    IF XACT_STATE() &lt;&gt; 1 OR @@TRANCOUNT &lt;&gt; 1&#10;        THROW 51006, 'No hay una transacción activa del ETL en CM_DWNEW.', 1;&#10;    DECLARE @Sql nvarchar(max) = CONVERT(nvarchar(max), N'')&#10;        + N'DELETE f&#10;FROM dbo.FactVentas AS f&#10;JOIN @CATALOGO@.dbo.stg_Partidos AS p ON p.IDPartidoOrigen = f.IDPartido;&#10;&#10;;WITH Ventas AS (&#10;    SELECT IDPartidoOrigen, IDTipoEntradaOrigen, COUNT(*) AS BoletosVendidos,&#10;           SUM(COALESCE(PrecioPagado, CONVERT(decimal(10,2), 0))) AS IngresosTaquilla&#10;    FROM @CATALOGO@.dbo.stg_Boletos&#10;    WHERE EstadoPago = ''Pagado''&#10;    GROUP BY IDPartidoOrigen, IDTipoEntradaOrigen&#10;)&#10;INSERT INTO dbo.FactVentas (&#10;    IDPartido, IDTipoEntrada, IDTiempoPartido, IDTemporada, IDEstadio, IDEtapa,&#10;    IDClubLocal, IDClubVisita, BoletosVendidos, IngresosTaquilla&#10;)&#10;SELECT p.IDPartidoOrigen, v.IDTipoEntradaOrigen, CONVERT(int, CONVERT(char(8), p.FechaHoraPartido, 112)),&#10;       p.IDTemporadaOrigen, p.IDEstadioOrigen, p.IDEtapaOrigen, p.IDClubLocalOrigen,&#10;       p.IDClubVisitaOrigen, v.BoletosVendidos, v.IngresosTaquilla&#10;FROM Ventas AS v&#10;JOIN @CATALOGO@.dbo.stg_Partidos AS p ON p.IDPartidoOrigen = v.IDPartidoOrigen;&#10;';&#10;    SET @Sql = REPLACE(@Sql, N'@CATALOGO@', QUOTENAME(@Catalogo));&#10;    EXEC sys.sp_executesql @Sql;&#10;END TRY&#10;BEGIN CATCH&#10;    IF XACT_STATE() &lt;&gt; 0 ROLLBACK TRANSACTION;&#10;    THROW;&#10;END CATCH;&#10;">
          </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Cargar FactAsistencia" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{F5AF8722-00E7-444E-A88D-087B4BC9C277}" DTS:ObjectName="Cargar FactAsistencia" DTS:DelayValidation="True" DTS:LocaleID="-1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{A9894B2F-66FE-4BB2-8D12-38C29CE8F6AF}" SQLTask:BypassPrepare="True" SQLTask:SqlStatementSource="DECLARE @Catalogo nvarchar(4000);&#10;SET @Catalogo = CONVERT(nvarchar(4000), SESSION_CONTEXT(N'ETL.BaseStaging'));&#10;SET NOCOUNT ON;&#10;SET XACT_ABORT ON;&#10;BEGIN TRY&#10;    IF @Catalogo IS NULL OR LEN(@Catalogo) = 0 OR LEN(@Catalogo) &gt; 128&#10;        THROW 51004, 'Configure BaseStaging con un nombre de base válido.', 1;&#10;    IF DB_ID(@Catalogo) IS NULL OR DB_ID(@Catalogo) = DB_ID()&#10;        THROW 51005, 'BaseStaging debe identificar otra base accesible en la instancia del DW.', 1;&#10;    IF XACT_STATE() &lt;&gt; 1 OR @@TRANCOUNT &lt;&gt; 1&#10;        THROW 51006, 'No hay una transacción activa del ETL en CM_DWNEW.', 1;&#10;    DECLARE @Sql nvarchar(max) = CONVERT(nvarchar(max), N'')&#10;        + N'DELETE f&#10;FROM dbo.FactAsistencia AS f&#10;JOIN @CATALOGO@.dbo.stg_Partidos AS p ON p.IDPartidoOrigen = f.IDPartido;&#10;&#10;INSERT INTO dbo.FactAsistencia (&#10;    IDPartido, IDTiempoPartido, IDTemporada, IDEstadio, IDEtapa,&#10;    IDClubLocal, IDClubVisita, EstadoPartido, AsistenciaRegistrada, AforoEstadio&#10;)&#10;SELECT p.IDPartidoOrigen, CONVERT(int, CONVERT(char(8), p.FechaHoraPartido, 112)),&#10;       p.IDTemporadaOrigen, p.IDEstadioOrigen, p.IDEtapaOrigen, p.IDClubLocalOrigen,&#10;       p.IDClubVisitaOrigen, p.EstadoPartido, a.AsistenciaRegistrada, a.AforoEstadio&#10;FROM @CATALOGO@.dbo.stg_Partidos AS p&#10;LEFT JOIN @CATALOGO@.dbo.stg_Asistencia AS a ON a.IDPartidoOrigen = p.IDPartidoOrigen;&#10;';&#10;    SET @Sql = REPLACE(@Sql, N'@CATALOGO@', QUOTENAME(@Catalogo));&#10;    EXEC sys.sp_executesql @Sql;&#10;    COMMIT TRANSACTION;&#10;END TRY&#10;BEGIN CATCH&#10;    IF XACT_STATE() &lt;&gt; 0 ROLLBACK TRANSACTION;&#10;    THROW;&#10;END CATCH;&#10;">
          </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Liberar staging" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{1415B17C-6308-4120-983A-03DB4BBF8B9E}" DTS:ObjectName="Liberar staging" DTS:DelayValidation="True" DTS:LocaleID="-1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{AB120B29-1A2E-4C16-A2CC-3ABC748CD459}" SQLTask:BypassPrepare="True" SQLTask:SqlStatementSource="EXEC sys.sp_releaseapplock&#10;    @Resource = N'ETL_LigasAscenso.Staging', @LockOwner = 'Session';" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
