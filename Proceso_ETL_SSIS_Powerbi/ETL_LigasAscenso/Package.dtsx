            <component refId="Package\Extraer Partidos\Origen de OLE DB" componentClassID="Microsoft.OLEDBSource" contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7" description="Origen de OLE DB" name="Origen de OLE DB" usesDispositions="true" version="7" validateExternalMetadata="false">
              <properties>
                <property dataType="System.Int32" description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito." name="CommandTimeout">0</property>
                <property dataType="System.String" description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas." name="OpenRowset" />
                <property dataType="System.String" description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas." name="OpenRowsetVariable" />
                <property dataType="System.String" description="Comando SQL para ejecutar." name="SqlCommand" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    p.IDpartido AS [IDPartidoOrigen],
    t.IDtemporada AS [IDTemporadaOrigen],
    t.Anio AS [AnioTemporada],
    t.FechaInicio AS [FechaInicioTemporada],
    t.FechaFinal AS [FechaFinTemporada],
    e.IDetapa AS [IDEtapaOrigen],
    c.IDcompeticion AS [IDCompeticionOrigen],
    c.NombreCompeticion AS [NombreCompeticion],
    c.Organizador AS [Organizador],
    c.Nivelcompeticion AS [NivelCompeticion],
    e.nombreEtapa AS [NombreEtapa],
    e.nivelEtapa AS [NivelEtapa],
    CAST(e.FactorPrecio AS decimal(10,2)) AS [FactorPrecio],
    es.IDestadio AS [IDEstadioOrigen],
    es.NombreEstadio AS [NombreEstadio],
    ue.Departamento AS [DepartamentoEstadio],
    ue.Provincia AS [ProvinciaEstadio],
    ue.Distrito AS [DistritoEstadio],
    ue.Region AS [RegionEstadio],
    es.Categoria AS [CategoriaEstadio],
    es.MaxAforo AS [MaxAforo],
    l.IDclub AS [IDClubLocalOrigen],
    l.NombreClub AS [NombreClubLocal],
    ul.Departamento AS [DepartamentoClubLocal],
    ul.Provincia AS [ProvinciaClubLocal],
    l.AnioFundacion AS [AnioFundacionLocal],
    v.IDclub AS [IDClubVisitaOrigen],
    v.NombreClub AS [NombreClubVisita],
    uv.Departamento AS [DepartamentoClubVisita],
    uv.Provincia AS [ProvinciaClubVisita],
    v.AnioFundacion AS [AnioFundacionVisita],
    p.FechaHora AS [FechaHoraPartido],
    p.Jornada AS [Jornada],
    p.EstadoPartido AS [EstadoPartido]
FROM dbo.Partido AS p
JOIN dbo.temporada AS t ON t.IDtemporada = p.IDtemporada
JOIN dbo.Etapas AS e ON e.IDetapa = p.IDetapa
JOIN dbo.Competicion AS c ON c.IDcompeticion = e.IDcompeticion
JOIN dbo.Estadio AS es ON es.IDestadio = p.IDestadio
JOIN dbo.Ubicacion AS ue ON ue.IDubicacion = es.IDubicacion
JOIN dbo.Club AS l ON l.IDclub = p.IDequipoLocal
JOIN dbo.Ubicacion AS ul ON ul.IDubicacion = l.IDubicacion
JOIN dbo.Club AS v ON v.IDclub = p.IDequipoVisitante
JOIN dbo.Ubicacion AS uv ON uv.IDubicacion = v.IDubicacion;</property>
                <property dataType="System.String" description="Variable que contiene el comando SQL para ejecutar." name="SqlCommandVariable" />
                <property dataType="System.Int32" description="Especifica la página de códigos de columna para utilizar cuando la información de página de códigos no está disponible en el origen de datos." name="DefaultCodePage">1252</property>
                <property dataType="System.Boolean" description="Fuerza el uso del valor de la propiedad DefaultCodePage al describir datos de caracteres." name="AlwaysUseDefaultCodePage">false</property>
                <property dataType="System.Int32" description="Especifica el modo utilizado para obtener acceso a la base de datos." name="AccessMode" typeConverter="AccessMode">2</property>
                <property dataType="System.String" description="Asignaciones entre los parámetros del comando SQL y las variables." name="ParameterMapping" />
              </properties>
